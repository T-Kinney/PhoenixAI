# Secrets — NEVER commit. This file holds Anthropic, NVIDIA, OpenAI, xAI,
# Kalshi, Stripe and other live keys.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
release/
.build-cache/
*.tsbuildinfo

# Local app state: threads, messages, session bindings, the memory database,
# and run artifacts. Machine-specific, often large, and contains conversation
# content that does not belong in version control.
data/
*.db
*.db-wal
*.db-shm

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and scratch
*.log
.test-tmp/
.test_tmp/

# Prompts describing private projects. These name the internal modules and
# strategy structure of the ATLAS trading system; the repo is public, so they
# stay local. The file remains on disk — it is only untracked.
prompts/
