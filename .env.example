# Copy this file to %APPDATA%\PhoenixAI\.env for the packaged app, or to
# .env in the repository for development. Add only the providers you use.

# Direct model APIs and independent review agents
XAI_API_KEY=
MOONSHOT_API_KEY=
# KIMI_API_KEY is accepted as a compatibility alias when MOONSHOT_API_KEY is unset.
# KIMI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# QWEN_API_KEY is accepted as a compatibility alias when DASHSCOPE_API_KEY is unset.
# QWEN_API_KEY=

# Read-only Public.com market data. PhoenixAI does not expose account, portfolio,
# preflight, cancellation, or order-placement endpoints to the GUI or agents.
PUBLIC_COM_SECRET=
PUBLIC_COM_ACCOUNT_ID=

# Optional providers and gateways
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Stored for possible future use; PhoenixAI 0.1.5 hard-blocks OpenRouter inference.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
LITELLM_API_KEY=
LITELLM_URL=http://127.0.0.1:4000/v1

# Local OpenAI-compatible runtimes usually do not require keys.
OLLAMA_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434/v1
LM_STUDIO_API_KEY=
LM_STUDIO_URL=http://127.0.0.1:1234/v1
